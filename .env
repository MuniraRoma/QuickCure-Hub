# ============================================
# API Configuration
# ============================================
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_API_BASE_URL=http://localhost:5000
REACT_APP_BACKEND_URL=http://localhost:5000
REACT_APP_FRONTEND_URL=http://localhost:3000

# ============================================
# App Configuration
# ============================================
REACT_APP_WEBSITE_NAME=QuickCure Hub
REACT_APP_VERSION=1.0.0
REACT_APP_ENV=development
REACT_APP_EMAIL_USER=quickcurehub@gmail.com
REACT_APP_EMAIL_SUPPORT=support@quickcurehub.com

# ============================================
# API Timeout (milliseconds)
# ============================================
REACT_APP_API_TIMEOUT=30000

# ============================================
# File Upload Configuration
# ============================================
REACT_APP_MAX_FILE_SIZE=5242880  # 5MB
REACT_APP_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg

# ============================================
# Pagination
# ============================================
REACT_APP_DEFAULT_PAGE_SIZE=10

# ============================================
# Feature Flags
# ============================================
REACT_APP_ENABLE_AI_DIAGNOSIS=true
REACT_APP_ENABLE_VIDEO_CONSULTATION=true
REACT_APP_ENABLE_CHAT=true
REACT_APP_ENABLE_EMAIL_NOTIFICATIONS=true
REACT_APP_ENABLE_PUSH_NOTIFICATIONS=true
REACT_APP_ENABLE_SMS_NOTIFICATIONS=false
REACT_APP_ENABLE_WEBSOCKET=true
REACT_APP_ENABLE_HTTPS=false

# ============================================
# Appointment Settings
# ============================================
REACT_APP_MAX_APPOINTMENTS_PER_DAY=10
REACT_APP_APPOINTMENT_DURATION=30  # minutes
REACT_APP_REMINDER_BEFORE_APPOINTMENT=60  # minutes

# ============================================
# Reminder Settings
# ============================================
REACT_APP_MEDICINE_REMINDER_ENABLED=true

# ============================================
# Socket/WebSocket
# ============================================
REACT_APP_SOCKET_URL=http://localhost:5000

# ============================================
# Security
# ============================================
REACT_APP_ENABLE_CAPTCHA=false